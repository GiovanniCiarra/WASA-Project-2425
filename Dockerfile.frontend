# UselatestNodeLTS to build
FROM node:lts AS builder

# Copy Vue.jscode
WORKDIR /app
COPY webui/yarn.lock webui/package.json ./
RUN yarn install

### BuildVue.js into plainHTML/CSS/JS
COPY webui/ .
RUN yarn run build-prod


### Create finalcontainer
FROM nginx:stable

### Copy the(built)appf rom the builder image
COPY --from=builder /app/dist /usr/share/nginx/html
