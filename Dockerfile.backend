# Create a first temporary image named "builder"
FROM golang:1.19.1 AS builder

# Copy Go code (in "builder")
WORKDIR /src/
COPY go.mod .   
COPY go.sum .                      
COPY cmd/ ./cmd/                       
COPY service/ ./service/               

# Build executables (in "builder")
RUN go build -o /app/webapi ./cmd/webapi

# Create final container
FROM debian:bookworm

# Copy the executable fromthe"builder"image
WORKDIR /app/
COPY --from=builder /app/webapi ./

# Inform Docker about which port is used
EXPOSE 3000

# SetthedefaultprogramtoourGo backend
CMD ["/app/webapi"]

